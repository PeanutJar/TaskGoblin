{
  "name": "Task Goblin",
  "description": "Task & Distraction Management Extension",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "webNavigation",
    "tabs",
    "alarms"
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "Goblinface.png"
  },
  "icons": {
    "16": "icons/Goblinface.png",
    "32": "icons/Goblinface.png",
    "48": "icons/Goblinface.png",
    "128": "icons/Goblinface.png"
  },
  "background": {
    "service_worker": "scripts/backgroundscript.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["scripts/contentscript.js"],
      "run_at": "document_idle"
      
    }
  ] 
}

